      <title>一段从js数组中获取重复数据的代码</title>
      <link>https://mizuka-wu.github.io/posts/%E4%B8%80%E6%AE%B5%E4%BB%8E%E6%95%B0%E7%BB%84%E4%B8%AD%E8%8E%B7%E5%8F%96%E9%87%8D%E5%A4%8D%E6%95%B0%E6%8D%AE%E7%9A%84%E4%BB%A3%E7%A0%81/</link>
      <pubDate>Thu, 18 Oct 2018 11:12:53 +0000</pubDate>
      <guid>https://mizuka-wu.github.io/posts/%E4%B8%80%E6%AE%B5%E4%BB%8E%E6%95%B0%E7%BB%84%E4%B8%AD%E8%8E%B7%E5%8F%96%E9%87%8D%E5%A4%8D%E6%95%B0%E6%8D%AE%E7%9A%84%E4%BB%A3%E7%A0%81/</guid>
      <description>&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;
Array.prototype.duplicate=function() {

let tmp = [];

this.concat().sort().sort(function(a,b){

if(a==b &amp;amp;&amp;amp; tmp.indexOf(a) === -1) tmp.push(a);

});

return tmp;

}
&lt;/code&gt;&lt;/pre&gt;</description>
